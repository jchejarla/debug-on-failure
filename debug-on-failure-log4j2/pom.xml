<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.jchejarla</groupId>
        <artifactId>debug-on-failure-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>debug-on-failure-log4j2</artifactId>
    <name>debug-on-failure-log4j2</name>
    <description>Log4j2 appender that holds DEBUG events per unit of work and writes them when it fails.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.jchejarla</groupId>
            <artifactId>debug-on-failure-core</artifactId>
        </dependency>
        <!-- Provided: the application chooses its own Log4j2 version. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Tests need SLF4J's MDC to reach Log4j2's context data, as it does in a Spring Boot application. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Generates the plugin descriptor Log4j2 uses to find <DebugOnFailure> in XML.
                         Named explicitly because newer JDKs no longer run processors found on the class path. -->
                    <annotationProcessors>
                        <annotationProcessor>org.apache.logging.log4j.core.config.plugins.processor.PluginProcessor</annotationProcessor>
                    </annotationProcessors>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
